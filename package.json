{
  "name": "wbmb-p2p-lending",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run compile && vite build",
    "test": "npm run compile && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "playwright test && playwright test -c playwright.fixed.config.js && playwright test -c playwright.council.config.js && playwright test -c playwright.swap.config.js",
    "check": "npm test && npm run build && npm run test:browser",
    "test:real": "npm run compile && node --test tests/real/*.test.mjs",
    "deploy:bsc": "node scripts/deploy-bsc.mjs",
    "deploy:bsc:swap": "node scripts/deploy-swap-bsc.mjs",
    "relay:council": "node scripts/relay-council.mjs",
    "build:live": "RECORD=deployments/bsc-movn.json node scripts/build-live.mjs",
    "build:live:council": "RECORD=deployments/bsc-council-movn.json OUT_DIR=dist-live-council node scripts/build-live.mjs",
    "build:live:council-test": "RECORD=deployments/bsc-council-movn-test.json OUT_DIR=dist-live-council-test node scripts/build-live.mjs",
    "test:live": "playwright test -c playwright.live.config.js && playwright test -c playwright.live-council.config.js && playwright test -c playwright.live-swap.config.js",
    "test:real-web": "playwright test -c playwright.real.config.js",
    "rehearse": "npm run test:real && npm run test:live"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@walletconnect/ethereum-provider": "2.25.0",
    "ethers": "6.17.0",
    "qrcode": "1.5.4"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "hardhat": "3.18.0",
    "prettier": "3.9.9",
    "solc": "0.8.37",
    "vite": "8.3.1"
  }
}
